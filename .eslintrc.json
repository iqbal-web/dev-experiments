{
	"extends": ["plugin:@wordpress/eslint-plugin/recommended"],
	"env": {
		"browser": true,
		"es2021": true
	},
	"parserOptions": {
		"ecmaVersion": 2021,
		"sourceType": "module",
		"ecmaFeatures": {
			"jsx": true
		}
	},
	"rules": {
		"no-console": "warn",
		"react/prop-types": "error",
		"react/jsx-no-target-blank": "error",
		"@wordpress/no-unsafe-wp-apis": "warn",
		"@wordpress/i18n-text-domain": [
			"error",
			{
				"allowedTextDomain": "dev-experiments"
			}
		]
	},
	"settings": {
		"react": {
			"version": "detect"
		}
	}
}
