{
	"extends": ["@wordpress/stylelint-config/scss"],
	"rules": {
		"no-descending-specificity": null,
		"selector-class-pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*(__|--)?[a-z0-9]*(-[a-z0-9]+)*$",
		"max-nesting-depth": 3,
		"declaration-property-unit-allowed-list": {
			"font-size": ["rem", "em", "px"],
			"line-height": ["", "rem", "em"]
		}
	}
}
